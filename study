
import torch
print("torch version{}".format(torch.__version__))
print("cuda version{}".format(torch.version.cuda))

device = 'cuda' if torch.cuda.is_available() else 'cpu'
print(device)
from torchvision.datasets.mnist import MNIST
from torchvision.transforms import ToTensor
train_data = MNIST(root='./', train=True, download=True, transform=ToTensor())

train_data = MNIST(root='./', train=True, download=True,transform=ToTensor()) #학습용 데이터 #8
test_data = MNIST(root='./', train=False, download=False,transform=ToTensor()) # 테스트용 데이터 #2

print(len(train_data))
print(len(test_data))
import matplotlib.pyplot as plt

for i in range(9):
  plt.subplot(3,3, i + 1)
  plt.imshow(train_data.data[i])

plt.show()
# 데이터 불러오기 (dataloader()함수)

from torch.utils.data.dataloader import DataLoader

train_loader = DataLoader(train_data, batch_size=32, shuffle=True) # 셔플
test_loader = DataLoader(test_data, batch_size=32, shuffle=False)# 셔플
# 배치사이즈 = 60,000
#1장 1장 1장 넣는것이 아닌 32장 32장 32장 씩 넣는것임 테스트 데이터에서의 몇장의 사진을 넣어서 빠르게 학습시킬것인가 = batch
# 모델 정의 및 학습하기
#모델 정의
#데이터 호출
# 손실 계산
# 오차 역전파 및 최적화 (가중치 업데이트)
#원하는 만큼 반복

import torch
import torch.nn as nn
from torch.optim.adam import Adam

# 학습에 사용 할 gpu 설정
device = 'cuda' if torch.cuda.is_available() else 'cpu'
print(device)
# 모델 정의
model = nn.Sequential(
    nn.Linear(784, 64),
    nn.ReLU(),
    nn.Linear(64, 64),
    nn.ReLU(),
    nn.Linear(64, 10) #0 ~ 9
)

model.to(device)
# lr, optim 설정
lr = 1e-3 # 보폭 같은개념
optim = Adam(model.parameters(), lr = lr)

for epoch in range(10):
  for data, label in train_loader:

    optim.zero_grad()

    data = torch.reshape(data, (-1, 784)).to(device) # 배치, (높이*너비),(32,784)
    preds = model(data)

    loss = nn.CrossEntropyLoss()(preds, label.to(device))
    loss.backward() # 역전파 사용하겠다 선언
    optim.step() # 1스텝 weight값과 optim 업데이트 하기 위함

print(f"epoch{epoch + 1} loss: {loss.item()}")


torch.save(model.state_dict(), "./mnist.pth")
#4. 모델 성능 평가하기
model.eval() #|위에서는 학습 여기서는 모델을 트레이닝 하는 상태가 아니라는 것을 알려주는 코드
model.load_state_dict(torch.load('./mnist.pth', map_location=device))

num_corr = 0 # 분류에 성공한 전체의 수

with torch.no_grad(): # no_grad -> 기울기 계산하지 않겠다, 성능만 보겠다
  for data, label in test_loader:
    data = torch.reshape(data, (-1, 784)).to(device)

    output = model(data.to(device))

    preds = output.data.max(1)[1] # 모델이 예측한 값중 젤 높은값 계산

    corr = preds.eq(label.to(device).data).sum().item()
    num_corr += corr
    print(f"Accuracy:{num_corr/len(test_data)}")
